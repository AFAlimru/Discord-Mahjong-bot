# ─────────────────────────────────────────────────────────────
#  Suzume Tsuk 環境變數範本
#  使用方式：複製本檔為 .env，填入你自己的值。（.env 不會被提交到 Git）
#    cp .env.example .env      # macOS / Linux
#    copy .env.example .env    # Windows
# ─────────────────────────────────────────────────────────────

# 【必填】Discord Bot Token
#   到 https://discord.com/developers/applications 建立應用程式 → Bot → Reset Token 取得。
#   同一頁請開啟「MESSAGE CONTENT INTENT」（打字出牌需要）。
DISCORD_TOKEN=your_discord_bot_token_here

# 【選填】SQLite 資料庫檔路徑（預設 mahjong.db，啟動時自動建立）
DATABASE_PATH=mahjong.db

# ─────────────────────────────────────────────────────────────
#  後台儀表板（選填，給維運者自己看：伺服器數 / 在玩人數 / 房間）
#  公開版可能沒有 mahjong/web 這個套件，缺少時會自動略過、不影響機器人。
# ─────────────────────────────────────────────────────────────

# 是否啟用後台（true / false，預設 true）
WEB_ENABLED=true

# 後台監聽位址與埠（預設只綁本機 127.0.0.1；要對外請搭配反向代理）
WEB_HOST=127.0.0.1
WEB_PORT=8787

# 後台存取權杖（強烈建議設定）。設定後需以 ?token=... 或 Authorization: Bearer ... 存取。
# 留空＝不驗證（此時務必維持綁定 127.0.0.1）。
WEB_ADMIN_TOKEN=
